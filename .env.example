# Public, safe to expose in the browser. Use the project's publishable key, never a secret/service-role key.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Canonical public origin used for metadata and Auth redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# --- Integrações científicas (Fase 2.2). Todas opcionais e SOMENTE de servidor. ---
# Sem chave, o NCBI permite 3 requisições/s; o site usa ~2,5/s. Com chave, o limite sobe para 10/s.
# NCBI_API_KEY=
# E-mail de contato recomendado pelo NCBI para identificar a aplicação. Use um endereço verificado da
# proprietária; não use um endereço inacessível.
# NCBI_CONTACT_EMAIL=
# Só desenvolvimento/QA (ignorada com NODE_ENV=production): simula falhas de provedor.
# Formato: provedor=tipo[,provedor=tipo]. Provedores: ncbi-taxonomy, gbif. Tipos: timeout, rate_limited, error, malformed, slow.
# SCIENCE_FAULT=gbif=timeout
